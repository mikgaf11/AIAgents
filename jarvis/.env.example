# --- where the thinking happens ---
# Two options, and you need exactly one of them.
#
#   1. Claude. Best reasoning by a wide margin. Costs per token. Put your key
#      below (console.anthropic.com) or run `ant auth login`.
#   2. A local model. Free forever, runs on your machine, noticeably weaker.
#      Install Ollama from https://ollama.com, then:  ollama pull llama3.1:8b
#
# JARVIS_BACKEND=auto uses Claude if a key is present and falls back to the
# local model if not, so you can start free and add a key later.
ANTHROPIC_API_KEY=

JARVIS_BACKEND=auto              # auto | anthropic | ollama
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=llama3.1:8b
# Optional smaller model for background chores. Blank = use the one above.
JARVIS_OLLAMA_BACKGROUND_MODEL=

# --- identity ---
JARVIS_NAME=JARVIS
JARVIS_USER=Sir

# --- models ---
JARVIS_MODEL=claude-opus-5
JARVIS_BACKGROUND_MODEL=claude-sonnet-5
JARVIS_EFFORT=high              # low | medium | high | xhigh | max
JARVIS_BACKGROUND_EFFORT=low
JARVIS_MAX_TOKENS=32000

# --- server ---
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8788

# --- capabilities ---
# Safe mode jails file access to jarvis/workspace and allowlists shell commands.
JARVIS_SAFE_MODE=1
JARVIS_ENABLE_WEB=1
JARVIS_SHELL_TIMEOUT=30

# --- autonomy ---
# --- email (set these with `python3 connect.py`, don't hand-edit) ---
# The password must be an APP PASSWORD on any provider with 2FA.
# Host and port are inferred from the address for common providers.
JARVIS_EMAIL_ADDRESS=
JARVIS_EMAIL_PASSWORD=
JARVIS_EMAIL_IMAP_HOST=
JARVIS_EMAIL_IMAP_PORT=993
JARVIS_EMAIL_SMTP_HOST=
JARVIS_EMAIL_SMTP_PORT=587
JARVIS_EMAIL_SMTP_SSL=0
JARVIS_EMAIL_FOLDER=INBOX
JARVIS_EMAIL_POLL=180            # seconds between inbox checks
JARVIS_EMAIL_BATCH=15            # max messages triaged per sweep
JARVIS_EMAIL_FLAG=1              # flag important mail in your real mailbox
JARVIS_EMAIL_ANNOUNCE=4          # speak up at this priority (4 = critical only)
# Sending stays off unless you turn it on. Even then every message waits
# for you to press Approve in the HUD — nothing is ever sent automatically.
JARVIS_EMAIL_ALLOW_SEND=0

# --- autonomy schedule ---
JARVIS_BRIEFING_HOUR=8           # morning briefing time (24h, local)
JARVIS_BRIEFING_MINUTE=0
JARVIS_VENTURE_INTERVAL=21600    # seconds between venture reviews (6h)
JARVIS_TASK_WORKER=1             # run queued background work

JARVIS_COGNITION=1
JARVIS_COGNITION_INTERVAL=45     # seconds between background ticks
JARVIS_DEEP_REFLECTION=900       # max seconds between passes that cost tokens;
                                 # ticks with an unchanged world are free
JARVIS_PROACTIVE_AFTER_IDLE=120  # silence required before it may speak first
JARVIS_PROACTIVE_COOLDOWN=300    # minimum gap between unprompted remarks

# --- watching what you do ---
# Samples the foreground app name and window title every few seconds. That's
# all: no screenshots, no keystrokes, no page contents. Everything stays in
# jarvis/data/jarvis.db on this machine. Set to 0 to switch it off entirely.
JARVIS_ACTIVITY=1
JARVIS_ACTIVITY_INTERVAL=20      # seconds between samples
JARVIS_ACTIVITY_MIN_SESSION=45   # ignore stretches shorter than this (alt-tab noise)
JARVIS_PLAY_CATEGORIES=game,media
JARVIS_PLAY_LIMIT=120            # minutes of play before it says something
JARVIS_PLAY_REMINDER_EVERY=45    # minutes before it mentions it again
JARVIS_FOCUS_NUDGE=90            # minutes in one session before a break nudge

# To teach it your own apps, drop a JSON file at data/activity_rules.json:
#   {"game": ["mygameclient"], "work": ["ourinternaltool"]}

# --- interrupting you ---
# An assistant that interrupts freely gets muted within a day, so there is a
# floor on the gap between nudges and a cap per hour. Raise the gap if it
# still feels chatty.
JARVIS_DESKTOP_NOTIFICATIONS=1   # real OS notifications, so nudges land behind a game
JARVIS_NUDGE_MIN_GAP=900         # seconds between interruptions
JARVIS_NUDGE_MAX_PER_HOUR=3
JARVIS_COACHING=1                # let it suggest things unprompted
JARVIS_COACHING_INTERVAL=1800    # seconds between "is this worth saying" checks

# --- learning about you ---
# Periodically reviews where your time went and what you asked for, and
# writes down conclusions. Those go into every future conversation as
# context. Nothing is uploaded, and nothing retrains a model.
JARVIS_LEARNING=1
JARVIS_LEARNING_INTERVAL=7200    # seconds between passes (2h)

# --- news ---
# Topics for the morning bulletin, delivered just after the briefing.
# Leave blank to skip it. Needs JARVIS_ENABLE_WEB=1.
JARVIS_NEWS_TOPICS=

# --- reaching the rest of your machine ---
# Safe mode confines file access to jarvis/workspace. Name extra folders here
# to widen it without handing over a shell — this is how it opens, searches
# and edits your real files.
JARVIS_FILE_ROOTS=
# e.g. JARVIS_FILE_ROOTS=~/Documents,~/Projects,~/Desktop

# Where to look when you ask it to play something.
JARVIS_MUSIC_DIRS=~/Music

# Opening files and launching apps. 0 means it can read and write but never
# starts anything.
JARVIS_ALLOW_OPEN=1
